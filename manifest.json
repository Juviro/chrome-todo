{
  "manifest_version": 3,
  "name": "Todo",
  "version": "1.0.0",
  "description": "A minimal todo list on your new tab.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
